# cp .env.example .env,然後改下面幾行。
# docker compose 會自動讀同目錄嘅 .env。
# ⚠️ .env 唔好入 git。上游 .gitignore 原本冇排除 .env(佢只排除咗
#    config.toml 同 storage/),所以呢個 kit 順手補咗一行落 .gitignore。

# 你嘅域名 —— 一定要填,唔填 compose 會直接唔肯起(故意嘅)。
# Streamlit 用佢生成瀏覽器嗰邊嘅絕對網址。
PUBLIC_HOST=mpt.example.com

TZ=Asia/Hong_Kong

# 資源上限:按你部 VPS 真實規格調,唔好照抄。
# 一部 2 core / 4G 嘅細 VPS:webui 同 api 加埋唔好超過實際核數,
# 否則渲染起上嚟會爭到成部機卡死。
WEBUI_CPUS=2
WEBUI_MEM=4g
API_CPUS=1
API_MEM=2g
